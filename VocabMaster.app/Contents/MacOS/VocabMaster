#!/bin/bash
# VocabMaster launcher
# Starts a local web server in the background, opens the browser, then exits.
# macOS requires the executable to exit promptly; the server lives on via nohup.

RESOURCES="$(cd "$(dirname "$0")/../Resources" && pwd)"
PORT=7654
PIDFILE="/tmp/vocabmaster_server.pid"

# ── Kill any previous VocabMaster server ──────────────────────
if [ -f "$PIDFILE" ]; then
  OLD_PID=$(cat "$PIDFILE" 2>/dev/null)
  if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    kill "$OLD_PID" 2>/dev/null
    sleep 0.2
  fi
  rm -f "$PIDFILE"
fi

# Also free the port in case anything else is holding it
lsof -ti:"$PORT" | xargs kill -9 2>/dev/null
sleep 0.2

# ── Start Python HTTP server detached (nohup keeps it alive after exit) ──
cd "$RESOURCES"
nohup python3 -m http.server "$PORT" > /tmp/vocabmaster.log 2>&1 &
SERVER_PID=$!
echo "$SERVER_PID" > "$PIDFILE"

# ── Wait briefly for server to be ready ───────────────────────
for i in 1 2 3 4 5; do
  sleep 0.3
  if curl -s --max-time 1 "http://localhost:$PORT" > /dev/null 2>&1; then
    break
  fi
done

# ── Open browser and exit immediately ─────────────────────────
open "http://localhost:$PORT"
exit 0
